{
  "name": "library-server",
  "version": "1.0.0",
  "description": "Backend API para sistema de biblioteca web",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env dist/server.js",
    "build": "rm -rf dist & tsc",
    "dev": "nodemon --exec node --loader ts-node/esm --env-file=.env src/server.ts",
    "debug": "nodemon --exec \"node --inspect --loader ts-node/esm --env-file=.env\" src/server.ts",
    "test": "node --test"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/pg": "^8.16.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "express": "^4.22.1",
    "express-validator": "^7.2.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.3",
    "eslint": "^10.0.0",
    "globals": "^16.4.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
