{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug TS (ts-node/esm)",
      "runtimeArgs": ["--loader", "ts-node/esm", "--env-file=.env"],
      "program": "${workspaceFolder}/src/server.ts",
      "skipFiles": ["<node_internals>/**"]
    },

    {
      "type": "node",
      "request": "attach",
      "name": "Attach Nodemon",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
